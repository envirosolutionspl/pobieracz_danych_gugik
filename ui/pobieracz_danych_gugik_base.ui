.QGroupBox { border-style: solid; border-width: 1px; border-radius: 6px; margin-top: 10px; padding: 10px 4px 4px 4px; font-weight: 700; }
.QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0px 4px; }

QRadioButton, QCheckBox { spacing: 6px; }
