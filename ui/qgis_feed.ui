  <property name="styleSheet">
   <string notr="true">QLabel#label { font-size: 14px; }
QLabel#lbl_field { font-weight: 700; }
QLabel#lbl_logo { padding: 2px 6px; }
QComboBox { border-radius: 4px; padding: 3px 8px; min-height: 22px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 22px; border: none; }
QComboBox::down-arrow { image: url(pdgimg:chevron_down.svg); width: 12px; height: 12px; }
QPushButton#pushButton { font-weight: 700; border: none; border-radius: 4px; padding: 5px 16px; }
QPushButton:focus, QComboBox:focus { outline: none; }

QDialog[theme="light"] { background: #ffffff; }
QDialog[theme="light"] QLabel { color: #23282a; }
QDialog[theme="light"] QLabel#label { color: #3b5a3e; }
QDialog[theme="light"] QFrame#footer_frame { background: #f6f8f6; border: none; border-top: 1px solid #d6ded6; }
QDialog[theme="light"] QComboBox { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QComboBox:focus, QDialog[theme="light"] QComboBox:on { border: 1px solid #4c6e4f; }
QDialog[theme="light"] QComboBox QAbstractItemView { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QPushButton#pushButton { background: #4c6e4f; color: #ffffff; }
QDialog[theme="light"] QPushButton#pushButton:hover { background: #5b8260; }
QDialog[theme="light"] QPushButton#pushButton:pressed { background: #3d5a40; }

QDialog[theme="dark"] { background: #2b2d2e; }
QDialog[theme="dark"] QLabel { color: #e6e9e7; }
QDialog[theme="dark"] QLabel#label { color: #a9cfac; }
QDialog[theme="dark"] QFrame#footer_frame { background: #303334; border: none; border-top: 1px solid #44494a; }
QDialog[theme="dark"] QComboBox { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; selection-background-color: #5b8260; selection-color: #ffffff; }
QDialog[theme="dark"] QComboBox:focus, QDialog[theme="dark"] QComboBox:on { border: 1px solid #6f9c73; }
QDialog[theme="dark"] QComboBox QAbstractItemView { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; selection-background-color: #5b8260; selection-color: #ffffff; }
QDialog[theme="dark"] QPushButton#pushButton { background: #5b8260; color: #ffffff; }
QDialog[theme="dark"] QPushButton#pushButton:hover { background: #6f9c73; }
QDialog[theme="dark"] QPushButton#pushButton:pressed { background: #4c6e4f; }</string>
